--- a/index.cjs
+++ b/index.cjs
@@ -4944,6 +4944,8 @@ class GitIgnoreManager {
   }
 }
 
+const looseObjectWriteLock = new AsyncLock({ maxPending: Infinity });
+
 async function writeObjectLoose({ fs, gitdir, object, format, oid }) {
   if (format !== 'deflated') {
     throw new InternalError(
@@ -4955,7 +4957,10 @@ async function writeObjectLoose({ fs, gitdir, object, format, oid }) {
   // Don't overwrite existing git objects - this helps avoid EPERM errors.
   // Although I don't know how we'd fix corrupted objects then. Perhaps delete them
   // on read?
-  if (!(await fs.exists(filepath))) await fs.write(filepath, object);
+  // An existing object may still be an incomplete write from another caller.
+  await looseObjectWriteLock.acquire(filepath, async () => {
+    if (!(await fs.exists(filepath))) await fs.write(filepath, object);
+  });
 }
 
