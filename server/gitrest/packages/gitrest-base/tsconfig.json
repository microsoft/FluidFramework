{
	"extends": "@fluidframework/build-common/ts-common-config.json",
	"exclude": ["src/test/**/*"],
	"compilerOptions": {
		"module": "Node20",
		"moduleResolution": "Node16",
		"types": ["node"],
		"strictNullChecks": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"composite": true,
		"skipLibCheck": true,
	},
	"include": ["src/**/*"],
}
