{
	"name": "@fluid-private/changelog-generator-wrapper",
	"version": "3.14.0",
	"private": true,
	"homepage": "https://fluidframework.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/microsoft/FluidFramework.git",
		"directory": "packages/tools/changelog-generator-wrapper"
	},
	"license": "MIT",
	"author": "Microsoft and contributors",
	"type": "commonjs",
	"main": "./src/index.js",
	"scripts": {
		"build": "concurrently npm:build:compile npm:lint",
		"build:cjs": "echo \"No build required.\"",
		"build:commonjs": "npm run build:cjs",
		"build:compile": "npm run build:commonjs",
		"check:biome": "biome check .",
		"check:format": "npm run check:biome",
		"clean": "rimraf --glob dist lib \"**/*.tsbuildinfo\" \"**/*.build.log\" nyc",
		"eslint": "eslint --quiet --format stylish src",
		"eslint:fix": "eslint --quiet --format stylish src --fix --fix-type problem,suggestion,layout",
		"format": "npm run format:biome",
		"format:biome": "biome check . --write",
		"lint": "npm run eslint",
		"lint:fix": "npm run format && npm run eslint:fix",
		"test": "npm run test:mocha",
		"test:mocha": "npm run test:mocha:cjs",
		"test:mocha:cjs": "mocha",
		"test:update-snapshots": "pnpm test:mocha:cjs --snapshot"
	},
	"dependencies": {
		"@changesets/cli": "^2.29.8",
		"@changesets/types": "^6.0.0",
		"changesets-format-with-issue-links": "^0.3.0",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.1",
		"typescript": "~6.0.3",
		"unist-util-visit": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "~2.4.5",
		"@fluid-internal/mocha-test-setup": "workspace:~",
		"@fluidframework/build-common": "^2.0.3",
		"@fluidframework/eslint-config-fluid": "catalog:eslint",
		"@types/mocha": "^10.0.10",
		"@types/node": "catalog:types",
		"concurrently": "^10.0.3",
		"eslint": "catalog:eslint",
		"jiti": "^2.6.1",
		"mocha": "^11.7.5",
		"rimraf": "^6.1.3"
	},
	"typeValidation": {
		"disabled": true
	}
}
