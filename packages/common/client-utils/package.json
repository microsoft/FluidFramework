{
	"name": "@fluid-internal/client-utils",
	"version": "3.0.0",
	"description": "Not intended for use outside the Fluid Framework.",
	"homepage": "https://fluidframework.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/microsoft/FluidFramework.git",
		"directory": "packages/common/client-utils"
	},
	"license": "MIT",
	"author": "Microsoft and contributors",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"node": {
				"import": {
					"types": "./lib/indexNode.d.ts",
					"default": "./lib/indexNode.js"
				},
				"require": {
					"types": "./dist/indexNode.d.ts",
					"default": "./dist/indexNode.js"
				}
			},
			"default": {
				"import": {
					"types": "./lib/indexBrowser.d.ts",
					"default": "./lib/indexBrowser.js"
				},
				"require": {
					"types": "./dist/indexBrowser.d.ts",
					"default": "./dist/indexBrowser.js"
				}
			}
		},
		"./internal-api-report/current": {
			"import": {
				"types": {
					"browser current": "./lib/client-utils.browser.alpha.d.ts",
					"node current": "./lib/client-utils.node.alpha.d.ts"
				}
			}
		},
		"./internal-api-report/legacy": {
			"import": {
				"types": {
					"browser legacy": "./lib/client-utils.browser.legacy.d.ts",
					"node legacy": "./lib/client-utils.node.legacy.d.ts"
				}
			}
		}
	},
	"scripts": {
		"build": "fluid-build . --task build",
		"build:api-reports": "concurrently \"npm:build:api-reports:browser:*\" && concurrently \"npm:build:api-reports:node:*\"",
		"build:api-reports:browser:current": "api-extractor run --local --config api-extractor/api-extractor-report-browser.current.json",
		"build:api-reports:browser:legacy": "api-extractor run --local --config api-extractor/api-extractor-report-browser.legacy.json",
		"build:api-reports:node:current": "npm run ci:build:api-reports:node:current",
		"build:api-reports:node:legacy": "npm run ci:build:api-reports:node:legacy",
		"build:cjs": "fluid-tsc commonjs --project ./tsconfig.cjs.json && copyfiles -f ../../../common/build/build-common/src/cjs/package.json ./dist",
		"build:commonjs": "fluid-build . --task commonjs",
		"build:compile": "fluid-build . --task compile",
		"build:docs": "api-extractor run --local --config api-extractor/api-extractor-model-browser.json",
		"build:esm": "tsc --project ./tsconfig.json",
		"build:exports:browser": "flub generate entrypoints --outFileLegacyBeta legacy --outFilePrefix {@unscopedPackageName}.browser. --mainEntrypoint ./src/indexBrowser.ts --outDir ./lib",
		"build:exports:node": "flub generate entrypoints --outFileLegacyBeta legacy --outFilePrefix {@unscopedPackageName}.node. --mainEntrypoint ./src/indexNode.ts --outDir ./lib",
		"build:test": "concurrently npm:build:test:mocha npm:build:test:playwright npm:build:test:types",
		"build:test:mocha": "concurrently npm:build:test:mocha:esm npm:build:test:mocha:cjs",
		"build:test:mocha:cjs": "fluid-tsc commonjs --project ./src/test/mocha/tsconfig.cjs.json",
		"build:test:mocha:esm": "tsc --project ./src/test/mocha/tsconfig.json",
		"build:test:playwright": "tsc --project ./src/test/playwright/tsconfig.json && webpack --config webpack.playwright.cjs",
		"build:test:types": "tsc --project ./src/test/types/tsconfig.json",
		"check:are-the-types-wrong": "attw --pack . --profile node16 --exclude-entrypoints ./internal-api-report/current ./internal-api-report/legacy",
		"check:biome": "biome check .",
		"check:exports": "concurrently \"npm:check:exports:*\"",
		"check:exports:bundle-release-tags": "api-extractor run --config api-extractor/api-extractor-lint-bundle.json",
		"check:exports:cjs:indexBrowser": "api-extractor run --config api-extractor/api-extractor-lint-indexBrowser.cjs.json",
		"check:exports:cjs:indexNode": "api-extractor run --config api-extractor/api-extractor-lint-indexNode.cjs.json",
		"check:exports:esm:browser:current": "api-extractor run --config api-extractor/api-extractor-lint-browser.current.esm.json",
		"check:exports:esm:browser:legacy": "api-extractor run --config api-extractor/api-extractor-lint-browser.legacy.esm.json",
		"check:exports:esm:indexBrowser": "api-extractor run --config api-extractor/api-extractor-lint-indexBrowser.esm.json",
		"check:exports:esm:indexNode": "api-extractor run --config api-extractor/api-extractor-lint-indexNode.esm.json",
		"check:exports:esm:node:current": "api-extractor run --config api-extractor/api-extractor-lint-node.current.esm.json",
		"check:exports:esm:node:legacy": "api-extractor run --config api-extractor/api-extractor-lint-node.legacy.esm.json",
		"check:format": "npm run check:biome",
		"ci:build:api-reports": "concurrently \"npm:ci:build:api-reports:*\"",
		"ci:build:api-reports:browser:current": "api-extractor run --config api-extractor/api-extractor-report-browser.current.json",
		"ci:build:api-reports:browser:legacy": "api-extractor run --config api-extractor/api-extractor-report-browser.legacy.json",
		"ci:build:api-reports:node:current": "api-extractor run --config api-extractor/api-extractor-report-node.current.json",
		"ci:build:api-reports:node:legacy": "api-extractor run --config api-extractor/api-extractor-report-node.legacy.json",
		"ci:build:docs": "api-extractor run --config api-extractor/api-extractor-model-browser.json",
		"clean": "rimraf --glob _api-extractor-temp dist lib \"**/*.tsbuildinfo\" \"**/*.build.log\" nyc",
		"eslint": "eslint --quiet --format stylish src",
		"eslint:fix": "eslint --quiet --format stylish src --fix --fix-type problem,suggestion,layout",
		"format": "npm run format:biome",
		"format:biome": "biome check . --write",
		"layerGeneration:gen": "flub generate compatLayerGeneration --dir . -v",
		"lint": "fluid-build . --task lint",
		"lint:fix": "fluid-build . --task eslint:fix --task format",
		"test": "npm run test:mocha && npm run test:playwright",
		"test:coverage": "c8 npm test",
		"test:mocha": "npm run test:mocha:esm && echo Skipping CJS - npm run test:mocha:cjs",
		"test:mocha:cjs": "cross-env FLUID_TEST_MODULE_SYSTEM=CJS \"MOCHA_SPEC=dist/test/mocha/**/*.spec.*js\" mocha",
		"test:mocha:esm": "cross-env \"MOCHA_SPEC=lib/test/mocha/**/*.spec.*js\" mocha",
		"test:playwright": "playwright test",
		"typetests:gen": "flub generate typetests --dir . -v"
	},
	"c8": {
		"all": true,
		"cache-dir": "nyc/.cache",
		"exclude": [
			"src/test/**/*.*ts",
			"dist/test/**/*.*js",
			"lib/test/**/*.*js"
		],
		"exclude-after-remap": false,
		"include": [
			"src/**/*.*ts",
			"dist/**/*.*js",
			"lib/**/*.*js"
		],
		"report-dir": "nyc/report",
		"reporter": [
			"cobertura",
			"html",
			"text"
		],
		"temp-directory": "nyc/.nyc_output"
	},
	"dependencies": {
		"@fluidframework/core-interfaces": "workspace:~",
		"@fluidframework/core-utils": "workspace:~",
		"@types/events_pkg": "npm:@types/events@^3.0.0",
		"base64-js": "^1.5.1",
		"buffer": "^6.0.3",
		"events_pkg": "npm:events@^3.1.0",
		"sha.js": "^2.4.12"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "~2.4.5",
		"@fluid-internal/client-utils-previous": "npm:@fluid-internal/client-utils@2.116.0",
		"@fluid-internal/mocha-test-setup": "workspace:~",
		"@fluid-tools/build-cli": "catalog:buildTools",
		"@fluidframework/build-common": "^2.0.3",
		"@fluidframework/build-tools": "catalog:buildTools",
		"@fluidframework/eslint-config-fluid": "catalog:eslint",
		"@microsoft/api-extractor": "7.58.1",
		"@playwright/test": "^1.62.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "catalog:types",
		"@types/sha.js": "^2.4.4",
		"@types/sinon": "^17.0.3",
		"c8": "^10.1.3",
		"concurrently": "^10.0.3",
		"copyfiles": "^2.4.1",
		"cross-env": "^10.1.0",
		"eslint": "catalog:eslint",
		"eslint-config-prettier": "catalog:eslint",
		"jiti": "^2.6.1",
		"mocha": "^11.7.5",
		"mocha-multi-reporters": "^1.5.1",
		"rimraf": "^6.1.3",
		"sinon": "^18.0.1",
		"ts-node": "^10.9.2",
		"typescript": "~6.0.3",
		"webpack": "^5.94.0",
		"webpack-cli": "^5.1.4"
	},
	"fluidBuild": {
		"tasks": {
			"eslint": [
				"build:esm"
			],
			"build:api-reports:browser:current": [
				"build:exports:browser",
				"^build:api-reports"
			],
			"build:api-reports:browser:legacy": [
				"build:exports:browser",
				"^build:api-reports"
			],
			"build:api-reports:node:current": [
				"build:api-reports:browser:current",
				"^build:api-reports"
			],
			"build:api-reports:node:legacy": [
				"build:api-reports:browser:legacy",
				"^build:api-reports"
			],
			"build:exports:browser": [
				"build:esm"
			],
			"build:exports:node": [
				"build:esm"
			],
			"build:test:mocha:cjs": [
				"build:cjs"
			],
			"build:test:mocha:esm": [
				"build:esm"
			],
			"build:test:types": [
				"build:esm"
			],
			"check:exports:bundle-release-tags": [
				"build:exports:browser"
			],
			"check:exports:cjs:indexBrowser": [
				"build:cjs"
			],
			"check:exports:cjs:indexNode": [
				"build:cjs"
			],
			"check:exports:esm:browser:current": [
				"build:exports:browser"
			],
			"check:exports:esm:browser:legacy": [
				"build:exports:browser"
			],
			"check:exports:esm:indexBrowser": [
				"build:esm"
			],
			"check:exports:esm:indexNode": [
				"build:exports:node"
			],
			"check:exports:esm:node:current": [
				"build:exports:node"
			],
			"check:exports:esm:node:legacy": [
				"build:exports:node"
			],
			"ci:build:api-reports:browser:current": [
				"build:exports:browser",
				"^ci:build:api-reports"
			],
			"ci:build:api-reports:browser:legacy": [
				"build:exports:browser",
				"^ci:build:api-reports"
			],
			"ci:build:api-reports:node:current": [
				"build:exports:node",
				"^ci:build:api-reports"
			],
			"ci:build:api-reports:node:legacy": [
				"build:exports:node",
				"^ci:build:api-reports"
			],
			"test:mocha:cjs": [
				"build:test:mocha:cjs"
			],
			"test:mocha:esm": [
				"build:test:mocha:esm"
			]
		}
	},
	"fluidCompatMetadata": {
		"generation": 9,
		"releaseDate": "2026-08-10",
		"releasePkgVersion": "2.115.0"
	},
	"typeValidation": {
		"broken": {
			"Class_Buffer": {
				"backCompat": false
			},
			"Function_Uint8ArrayToArrayBuffer": {
				"backCompat": false
			},
			"TypeAlias_IsoBuffer": {
				"backCompat": false
			},
			"Variable_IsoBuffer": {
				"backCompat": false
			},
			"Variable_LayerCompatibilityPolicyWindowMonths": {
				"backCompat": false
			}
		},
		"entrypoint": ""
	}
}
