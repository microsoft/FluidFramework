{
	"extends": "../../../common/build/build-common/tsconfig.node20.json",
	"include": ["src/**/*"],
	"exclude": ["src/test/**/*"],
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./lib",
		"exactOptionalPropertyTypes": false,
		"noUnusedLocals": false,
		// ES2021 needed for FinalizationRegistry
		"lib": ["ES2021", "DOM", "DOM.Iterable"],
		// Suppress type errors in Quill's use of @quill-next/delta-es.
		// Without this, the Quill code gives a lot of errors like:
		// node_modules/.pnpm/quill-next@2.2.6/node_modules/quill-next/dist/core/quill.d.ts:200:27 - error TS2709: Cannot use namespace 'Delta' as a type.
		// These errors occur because @quill-next/delta-es ships CommonJS type declarations, which do not work well with node16 module resolution.
		"skipLibCheck": true,
	},
}
