{
	"name": "@fluid-internal/presence-definitions",
	"version": "3.0.0",
	"description": "Core type definitions and interfaces for Fluid Framework presence",
	"homepage": "https://fluidframework.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/microsoft/FluidFramework.git",
		"directory": "packages/framework/presence-definitions"
	},
	"license": "MIT",
	"author": "Microsoft and contributors",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./internal": "./lib/internal.js",
		"./internal/workspace": "./lib/workspace/workspaceTypes.js",
		"./internal/workspace-runtime": "./lib/workspace-runtime/presenceStatesTypes.js",
		"./internal/workspace-states": "./lib/workspace-states/stateDatastoreTypes.js"
	},
	"files": [
		"dist/**/*",
		"lib/**/*",
		"!**/test/**"
	],
	"scripts": {
		"build": "fluid-build . --task build",
		"build:api-reports": "api-extractor run --local --config api-extractor/api-extractor-report.json",
		"build:cjs": "fluid-tsc commonjs --project ./tsconfig.cjs.json && copyfiles -f ./src/cjs/package.json ./dist",
		"build:commonjs": "fluid-build . --task commonjs",
		"build:compile": "fluid-build . --task compile",
		"build:docs": "api-extractor run --local --config api-extractor/api-extractor-model.json",
		"build:esm": "tsc --project ./tsconfig.json",
		"build:test": "concurrently npm:build:test:esm npm:build:test:cjs",
		"build:test:cjs": "echo disabled: fluid-tsc commonjs --project ./src/test/tsconfig.cjs.json",
		"build:test:esm": "tsc --project ./src/test/tsconfig.json",
		"check:are-the-types-wrong": "attw --pack . --profile esm-only",
		"check:biome": "biome check .",
		"check:exports": "concurrently \"npm:check:exports:*\"",
		"check:exports:bundle-release-tags": "api-extractor run --config api-extractor/api-extractor-lint-bundle.json",
		"check:exports:cjs:index": "echo disabled: api-extractor run --config api-extractor/api-extractor-lint-index.cjs.json",
		"check:exports:esm:index": "api-extractor run --config api-extractor/api-extractor-lint-index.esm.json",
		"check:format": "npm run check:biome",
		"ci:build:api-reports": "api-extractor run --config api-extractor/api-extractor-report.json",
		"ci:build:docs": "api-extractor run --config api-extractor/api-extractor-model.json",
		"clean": "rimraf --glob dist lib \"**/*.tsbuildinfo\" \"**/*.build.log\" _api-extractor-temp nyc",
		"eslint": "eslint --quiet --format stylish src",
		"eslint:fix": "eslint --quiet --format stylish src --fix --fix-type problem,suggestion,layout",
		"format": "npm run format:biome",
		"format:biome": "biome check . --write",
		"lint": "fluid-build . --task lint",
		"lint:fix": "fluid-build . --task eslint:fix --task format",
		"typetests:gen": "flub generate typetests --dir . -v"
	},
	"dependencies": {
		"@fluidframework/core-interfaces": "workspace:~",
		"@fluidframework/id-compressor": "workspace:~"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "~2.4.5",
		"@fluid-internal/presence-definitions-previous": "npm:@fluid-internal/presence-definitions@2.116.0",
		"@fluid-tools/build-cli": "catalog:buildTools",
		"@fluidframework/build-common": "^2.0.3",
		"@fluidframework/build-tools": "catalog:buildTools",
		"@fluidframework/eslint-config-fluid": "catalog:eslint",
		"@microsoft/api-extractor": "7.58.1",
		"concurrently": "^10.0.3",
		"copyfiles": "^2.4.1",
		"cross-env": "^10.1.0",
		"eslint": "catalog:eslint",
		"jiti": "^2.6.1",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3"
	},
	"fluidBuild": {
		"tasks": {
			"check:exports:cjs:index": [
				"build:esm"
			],
			"check:exports:esm:index": [
				"build:esm"
			]
		}
	},
	"typeValidation": {
		"entrypoint": "",
		"broken": {}
	}
}
