{
	"extends": "../../../../../../common/build/build-common/tsconfig.test.node16.json",
	"include": ["./**/*"],
	"compilerOptions": {
		// PropertyDDS relies on legacy class field semantics (useDefineForClassFields: false),
		// so pin the target below ES2022, where TypeScript would enable it by default.
		"target": "ES2021",
		"strict": false,
		"allowJs": true,
		"checkJs": true,

		"rootDir": "./",
		"outDir": "invalid use tsconfig.esm.json or tsconfig.cjs.json to build",
		"types": ["node", "mocha", "chai", "sinon"],
		// must be disabled per "strict": false.
		"exactOptionalPropertyTypes": false,
	},
	// Default reference for IntelliSense
	"references": [
		{
			"path": "../../tsconfig.json",
		},
	],
}
