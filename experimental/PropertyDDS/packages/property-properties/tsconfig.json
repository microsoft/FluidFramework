{
	"extends": "../../../../common/build/build-common/tsconfig.node16.json",
	"include": ["src/**/*"],
	"exclude": ["src/test/**/*"],
	"compilerOptions": {
		// PropertyDDS relies on legacy class field semantics (useDefineForClassFields: false),
		// so pin the target below ES2022, where TypeScript would enable it by default.
		"target": "ES2021",
		"strict": false,
		"allowJs": true,
		"checkJs": false,
		"rootDir": "./src",
		"outDir": "invalid use tsconfig.esm.json or tsconfig.cjs.json to build",
		"composite": true,
		"exactOptionalPropertyTypes": false,
	},
}
