{
	"extends": "../../../../common/build/build-common/tsconfig.node16.json",
	"include": ["src/**/*"],
	"exclude": ["src/test/**/*"],
	"compilerOptions": {
		// PropertyDDS relies on legacy class field semantics (useDefineForClassFields: false),
		// so pin the target below ES2022, where TypeScript would enable it by default.
		"target": "ES2021",
		"composite": true,
		"rootDir": "./src",
		"outDir": "./lib",
		"types": ["node"],
		"exactOptionalPropertyTypes": false,
		"noUncheckedIndexedAccess": false,
	},
}
