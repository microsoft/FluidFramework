{
	"extends": "../../../../../../common/build/build-common/tsconfig.test.node16.json",
	"compilerOptions": {
		// PropertyDDS relies on legacy class field semantics (useDefineForClassFields: false),
		// so pin the target below ES2022, where TypeScript would enable it by default.
		"target": "ES2021",
		"rootDir": "./",
		"outDir": "../../lib/test",
		"types": ["mocha", "node"],
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noImplicitOverride": true,
		"exactOptionalPropertyTypes": false,
	},
	"include": ["./**/*"],
	"references": [
		{
			"path": "../..",
		},
	],
}
