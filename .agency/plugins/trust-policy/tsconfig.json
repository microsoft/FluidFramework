{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": "src",
		"outDir": "lib",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noEmitOnError": true,
		"skipLibCheck": true,
		"types": ["node"],
		"sourceMap": true,
	},
	"include": ["src/**/*.ts"],
}
