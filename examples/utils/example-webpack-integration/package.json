{
	"name": "@fluid-example/example-webpack-integration",
	"version": "3.1.0",
	"private": true,
	"description": "Webpack configuration used by examples in the FluidFramework repo.",
	"homepage": "https://fluidframework.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/microsoft/FluidFramework.git",
		"directory": "examples/utils/example-webpack-integration"
	},
	"license": "MIT",
	"author": "Microsoft and contributors",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./lib/index.js"
	},
	"scripts": {
		"build": "fluid-build . --task build",
		"build:compile": "fluid-build . --task compile",
		"build:esm": "tsc --project ./tsconfig.json",
		"check:are-the-types-wrong": "attw --pack . --profile esm-only",
		"check:biome": "biome check .",
		"check:format": "npm run check:biome",
		"check:types:require-esm": "fluid-tsc commonjs --project ./tsconfig.json --noEmit --skipLibCheck --emitDeclarationOnly false --tsBuildInfoFile ./tsconfig.require-esm.tsbuildinfo",
		"clean": "rimraf --glob dist lib \"**/*.tsbuildinfo\" \"**/*.build.log\"",
		"eslint": "eslint --quiet --format stylish src",
		"eslint:fix": "eslint --quiet --format stylish src --fix --fix-type problem,suggestion,layout",
		"format": "npm run format:biome",
		"format:biome": "biome check . --write",
		"lint": "fluid-build . --task lint",
		"lint:fix": "fluid-build . --task eslint:fix --task format"
	},
	"dependencies": {
		"webpack": "^5.94.0",
		"webpack-dev-server": "~5.2.6"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "~2.4.5",
		"@fluid-tools/build-cli": "catalog:buildTools",
		"@fluidframework/build-common": "^2.0.3",
		"@fluidframework/build-tools": "catalog:buildTools",
		"@fluidframework/eslint-config-fluid": "catalog:eslint",
		"@types/node": "catalog:types",
		"copyfiles": "^2.4.1",
		"eslint": "catalog:eslint",
		"jiti": "^2.6.1",
		"rimraf": "^6.1.3",
		"typescript": "catalog:TypeScript"
	},
	"fluidBuild": {
		"_tasksComment1": "Only builds ESM; so, CJS deps are remapped to ESM.",
		"tasks": {
			"build:package:cjs": {
				"dependsOn": [
					"build:package:esm"
				],
				"script": false
			}
		}
	},
	"typeValidation": {
		"disabled": true
	}
}
