{
	"extends": "../../../common/build/build-common/tsconfig.node16.json",
	"include": ["src/**/*"],
	"exclude": ["src/test/**/*"],
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./lib",
		"types": ["node"],
		"noUncheckedIndexedAccess": false,
		"exactOptionalPropertyTypes": false,
		// webpack-dev-server@5 types reference open@10 (ESM-only), which trips TS1479 under Node16 CJS resolution.
		"skipLibCheck": true,
	},
}
