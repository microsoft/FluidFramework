{
	"name": "@fluid-tools/markdown-magic",
	"version": "3.0.0",
	"private": true,
	"description": "Contains shared utilities for Markdown content generation and embedding using markdown-magic.",
	"homepage": "https://fluidframework.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/microsoft/FluidFramework.git",
		"directory": "tools/markdown-magic"
	},
	"license": "MIT",
	"author": "Microsoft and contributors",
	"type": "module",
	"sideEffects": false,
	"bin": {
		"markdown-magic": "bin/markdown-magic"
	},
	"scripts": {
		"build": "npm run check:types && npm run build:docs",
		"build:docs": "node --import jiti/register src/index.ts --files README.md",
		"check:biome": "biome check .",
		"check:format": "npm run check:biome",
		"check:types": "tsc --noEmit",
		"format": "npm run format:biome",
		"format:biome": "biome check . --write",
		"test": "node --import jiti/register --test test/*.test.ts && node --import jiti/register src/index.ts --files \"test/**/*.md\" !test/README.md"
	},
	"dependencies": {
		"chalk": "^4.1.2",
		"globby": "^14.1.0",
		"jiti": "^2.6.1",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"unified": "^11.0.5",
		"yargs": "17.7.2"
	},
	"devDependencies": {
		"@biomejs/biome": "~2.4.5",
		"@fluidframework/build-common": "^2.0.3",
		"@types/mdast": "^4.0.4",
		"@types/node": "catalog:types",
		"@types/yargs": "^17.0.35",
		"typescript": "~6.0.3"
	},
	"typeValidation": {
		"disabled": true
	}
}
