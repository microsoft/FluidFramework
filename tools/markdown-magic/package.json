{
	"name": "@fluid-tools/markdown-magic",
	"version": "3.0.0",
	"private": true,
	"description": "Contains shared utilities for Markdown content generation and embedding using markdown-magic.",
	"homepage": "https://fluidframework.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/microsoft/FluidFramework.git",
		"directory": "tools/markdown-magic"
	},
	"license": "MIT",
	"author": "Microsoft and contributors",
	"type": "module",
	"sideEffects": false,
	"bin": {
		"markdown-magic": "bin/markdown-magic"
	},
	"scripts": {
		"build": "npm run build:docs",
		"build:docs": "node src/index.js --files README.md",
		"check:biome": "biome check .",
		"check:format": "npm run check:biome",
		"format": "npm run format:biome",
		"format:biome": "biome check . --write",
		"test": "node --test test/*.test.mjs && node src/index.js --files \"test/**/*.md\" !test/README.md"
	},
	"dependencies": {
		"chalk": "^4.1.2",
		"globby": "^14.1.0",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"yargs": "17.7.2"
	},
	"devDependencies": {
		"@biomejs/biome": "~2.4.5",
		"@fluidframework/build-common": "^2.0.3",
		"jiti": "^2.6.1"
	},
	"typeValidation": {
		"disabled": true
	}
}
