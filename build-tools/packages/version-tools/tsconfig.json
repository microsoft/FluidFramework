{
	"extends": "@fluidframework/build-common/ts-common-config.json",
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"composite": true,
		"rootDir": "./src",
		"outDir": "./lib",
		"types": ["node"],
		"noImplicitAny": true,
		"exactOptionalPropertyTypes": true,
	},
	"include": ["src/**/*"],
	"exclude": ["src/test/**/*"],
}
