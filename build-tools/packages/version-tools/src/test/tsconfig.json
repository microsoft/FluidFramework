{
	"extends": "@fluidframework/build-common/ts-common-config.json",
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"declaration": true,
		"importHelpers": true,
		"declarationMap": false,
		"rootDir": "./",
		"outDir": "../../lib/test",
		"types": ["node", "mocha", "chai"],
		"skipLibCheck": true,
		"exactOptionalPropertyTypes": true,
	},
	"include": ["./**/*"],
	"references": [
		{
			"path": "../..",
		},
	],
}
