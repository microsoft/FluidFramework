	"collector": "const fs = require('node:fs');\nconst cp = require('node:child_process');\nconst crypto = require('node:crypto');\nconst path = require('node:path');\nconst root = '/workspaces/rust-service-storage-optimization';\nconst owned = '/tmp/sea-storage-overhead-N5913w';\nconst head = '32ee6e92c87b82c23948d23d52db4c94670743c3';\nconst mode = process.argv[2];\nconst git = (...args) => cp.execFileSync('git', args, { cwd: root, encoding: 'utf8' }).trim();\nconst hash = file => crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex');\nif (process.cwd() !== root || git('rev-parse', 'HEAD') !== head || git('branch', '--show-current') !== 'rust-service-storage-optimization') throw Error('checkout mismatch');\nconst baseline = path.join(owned, 'baseline');\nconst candidate = path.join(root, 'rust-service/target/release/storage-pipeline');\nif (mode === 'baseline') {\n    if (git('status', '--porcelain')) throw Error('baseline requires clean tree');\n    fs.copyFileSync(candidate, baseline, fs.constants.COPYFILE_EXCL);\n    fs.chmodSync(baseline, 0o755);\n}\nconst sources = ['rust-service/Cargo.lock', 'rust-service/crates/sea-benchmarks/src/bin/storage-pipeline.rs', 'rust-service/crates/sea-sequencer/src/pipeline.rs', 'rust-service/crates/sea-sequencer/src/session.rs', 'rust-service/crates/sea-sequencer/src/fault_tests.rs'];\nconst evidence = {\n    head, branch: git('branch', '--show-current'), cwd: root, mode,\n    started: new Date().toISOString(), command: `node ${__filename} ${mode}`,\n    collector: fs.readFileSync(__filename, 'utf8'),\n    source_sha256: Object.fromEntries(sources.map(file => [file, hash(path.join(root, file))])),\n    binaries: Object.fromEntries((mode === 'baseline' ? [['baseline', baseline]] : [['baseline', baseline], ['candidate', candidate]]).map(([version, file]) => [version, {path:file, sha256:hash(file)}])),\n    rustc: cp.execFileSync('rustc', ['--version'], {encoding:'utf8'}).trim(),\n    kernel: cp.execFileSync('uname', ['-a'], {encoding:'utf8'}).trim(),\n    cpu_max: fs.readFileSync('/sys/fs/cgroup/cpu.max', 'utf8').trim(),\n    environment: Object.fromEntries(Object.entries(process.env).filter(([key]) => /^(RUST|CARGO|TOKIO)/.test(key))),\n    samples: []\n};\nconst directory = path.join(root, 'rust-service/measurements/2026-09-20/storage-overhead');\nfs.mkdirSync(directory, {recursive:true});\nconst output = path.join(directory, `${mode}.json`);\nif (fs.existsSync(output)) throw Error('evidence already exists');\nfor (let repetition = 1; repetition <= (mode === 'durable-repeat' ? 7 : 3); repetition++) {\n    const cells = mode === 'durable-repeat' ? [{backend:'durable-file',bytes:8192,window:128}] : ['memory', 'buffered-file', 'durable-file'].flatMap(backend => [64,8192].flatMap(bytes => [1,128].map(window => ({backend,bytes,window}))));\n    if (repetition === 2) cells.reverse();\n    for (const {backend, bytes, window} of cells) {\n        const versions = mode === 'baseline' ? ['baseline'] : repetition % 2 === 0 ? ['candidate','baseline'] : ['baseline','candidate'];\n        for (const version of versions) {\n            const binary = version === 'baseline' ? baseline : candidate;\n            const args = [backend, String(bytes), String(window), path.join(root, 'rust-service/target/storage-overhead-data')];\n            const started = new Date().toISOString();\n            const result = cp.spawnSync(binary, args, {cwd:root, encoding:'utf8', timeout:180000});\n            const rows = result.stdout.trim().split('\\n').filter(Boolean).map(row => JSON.parse(row));\n            evidence.samples.push({version,repetition,started,command:[binary,...args],status:result.status,signal:result.signal,stderr:result.stderr,rows});\n            fs.writeFileSync(output, JSON.stringify(evidence));\n            if (result.status !== 0 || rows.length !== 2 || rows.some(row => row.verified_deliveries !== row.operations || !row.verified_order)) throw Error(`failed cell ${backend} ${bytes} ${window}: ${result.stderr}`);\n            console.log(mode, repetition, version, backend, bytes, window, rows[1].operations_per_second.toFixed(1));\n        }\n    }\n}\nevidence.finished = new Date().toISOString();\nfs.writeFileSync(output, JSON.stringify(evidence));",
