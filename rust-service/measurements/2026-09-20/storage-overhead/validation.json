		"audit_source": "const fs = require('node:fs');\nconst cp = require('node:child_process');\nconst crypto = require('node:crypto');\nconst assert = require('node:assert/strict');\nconst root = '/workspaces/rust-service-storage-optimization';\nconst directory = `${root}/rust-service/measurements/2026-09-20/storage-overhead`;\nconst hash = value => crypto.createHash('sha256').update(value).digest('hex');\nconst git = (...args) => cp.execFileSync('git',args,{cwd:root,encoding:'utf8'}).trim();\nassert.equal(process.cwd(),root);\nassert.equal(git('rev-parse','HEAD'),'32ee6e92c87b82c23948d23d52db4c94670743c3');\nassert.equal(git('branch','--show-current'),'rust-service-storage-optimization');\nassert.equal(git('diff','--cached','--name-only'),'');\nconst expected = ['rust-service/STORAGE_OPTIMIZATION.md','rust-service/crates/sea-sequencer/src/fault_tests.rs','rust-service/crates/sea-sequencer/src/pipeline.rs'];\nassert.deepEqual(git('diff','--name-only').split('\\n'),expected);\nconst collections = ['baseline','candidate','durable-repeat'].map(name=>JSON.parse(fs.readFileSync(`${directory}/${name}.json`)));\nassert.deepEqual(collections.map(value=>value.samples.length),[36,72,14]);\nlet verifiedPhases = 0;\nfor (const collection of collections) {\n    assert.equal(collection.binaries.baseline.sha256,collections[0].binaries.baseline.sha256);\n    assert.equal(hash(fs.readFileSync(collection.binaries.baseline.path)),collection.binaries.baseline.sha256);\n    for (const [file,expectedHash] of Object.entries(collection.source_sha256)) {\n        const content = collection.mode === 'baseline' ? cp.execFileSync('git',['show',`HEAD:${file}`],{cwd:root}) : fs.readFileSync(`${root}/${file}`);\n        assert.equal(hash(content),expectedHash,file);\n    }\n    for (const sample of collection.samples) {\n        assert.equal(sample.status,0);\n        assert.equal(sample.rows.length,2);\n        for (const row of sample.rows) {\n            assert.equal(row.operations,row.phase === 'warmup' ? 128 : 4096);\n            assert.equal(row.verified_deliveries,row.operations);\n            assert.equal(row.verified_order,true);\n            assert.equal(row.physical_durability_verified,false);\n            verifiedPhases++;\n        }\n    }\n}\nassert.equal(fs.existsSync(`${root}/rust-service/target/storage-overhead-data`),false);\nconst validationPath = `${directory}/validation.json`;\nconst validation = JSON.parse(fs.readFileSync(validationPath));\nfor (const name of ['fmt','clippy','doc','build','test','documentation','wasm-clippy','policy','root-build','complete-test']) {\n    assert.ok(validation.commands.some(command=>command.name===name&&command.status===0),name);\n}\nconst log = fs.readFileSync('/tmp/sea-storage-overhead-N5913w/test-5.log','utf8');\nconst passed = [...log.matchAll(/test result: ok\\. (\\d+) passed/g)].reduce((total,match)=>total+Number(match[1]),0);\nvalidation.final_audit = {verified_phases:verifiedPhases,native_tests_passed:passed,source_hashes_match:true,baseline_binary_hash_matches:true,dataset_removed:true,index_unchanged:true,head:git('rev-parse','HEAD'),tracked_changes:expected,untracked_files:git('ls-files','--others','--exclude-standard').split('\\n'),audit_command:`node ${__filename}`,audit_source:fs.readFileSync(__filename,'utf8'),finished:new Date().toISOString()};\nfs.writeFileSync(validationPath,JSON.stringify(validation));\nconsole.log(JSON.stringify({...validation.final_audit,audit_source:undefined},null,2));",
