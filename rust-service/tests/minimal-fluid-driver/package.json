{
	"name": "@fluid-experimental/minimal-wasm-driver",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "fluid-build . --task build",
		"build:compile": "fluid-build . --task compile",
		"build:benchmark:rust": "esbuild browser/shared-tree-benchmark-rust.ts --bundle --format=esm --platform=browser --outfile=dist/shared-tree-benchmark-rust.js --external:../pkg/* --external:../pkg-local/*",
		"build:benchmark:local": "esbuild browser/shared-tree-benchmark-local.ts --bundle --format=esm --platform=browser --inject:browser/process-shim.ts --outfile=dist/shared-tree-benchmark-local.js",
		"build:benchmark:tinylicious": "esbuild browser/shared-tree-benchmark-tinylicious.ts --bundle --format=esm --platform=browser --outfile=dist/shared-tree-benchmark-tinylicious.js",
		"build:benchmarks": "pnpm run build:benchmark:rust && pnpm run build:benchmark:local && pnpm run build:benchmark:tinylicious",
		"build:typescript": "tsc --project tsconfig.json",
		"build:wasm": "node scripts/build-wasm.mjs",
		"benchmark:rust-local": "node browser/run-shared-tree-benchmark.mjs rust-local",
		"benchmark:rust": "node browser/run-shared-tree-benchmark.mjs rust",
		"benchmark:local": "node browser/run-shared-tree-benchmark.mjs local",
		"benchmark:tinylicious": "node browser/run-shared-tree-benchmark.mjs tinylicious",
		"build:shared-tree": "esbuild browser/shared-tree-trace.ts --bundle --format=esm --platform=browser --outfile=dist/shared-tree-trace.js --external:../pkg/*",
		"check:format": "biome format src browser scripts package.json tsconfig.json tsconfig.shared-tree.json index.html shared-tree.html shared-tree-benchmark-rust.html shared-tree-benchmark-local.html shared-tree-benchmark-tinylicious.html",
		"format": "biome format src browser scripts package.json tsconfig.json tsconfig.shared-tree.json index.html shared-tree.html shared-tree-benchmark-rust.html shared-tree-benchmark-local.html shared-tree-benchmark-tinylicious.html --write",
		"lint": "biome lint src browser scripts",
		"test": "fluid-build . --task test",
		"test:node": "node --test lib/*.test.js",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"typecheck:shared-tree": "tsc --project tsconfig.shared-tree.json"
	},
	"dependencies": {
		"@fluidframework/container-loader": "workspace:~",
		"@fluidframework/core-interfaces": "workspace:~",
		"@fluidframework/driver-definitions": "workspace:~",
		"@fluidframework/fluid-static": "workspace:~",
		"@fluidframework/local-driver": "workspace:~",
		"@fluidframework/server-local-server": "^7.0.1",
		"@fluidframework/tinylicious-client": "workspace:~",
		"@fluidframework/tree": "workspace:~",
		"process": "0.11.10"
	},
	"devDependencies": {
		"@biomejs/biome": "~2.4.5",
		"@types/node": "catalog:types",
		"esbuild": "0.28.2",
		"typescript": "~6.0.3"
	},
	"fluidBuild": {
		"declarativeTasks": {
			"node scripts/build-wasm.mjs": {
				"inputGlobs": [
					"package.json",
					"scripts/build-wasm.mjs",
					"${repoRoot}/rust-service/Cargo.toml",
					"${repoRoot}/rust-service/Cargo.lock",
					"${repoRoot}/rust-service/rust-toolchain.toml",
					"${repoRoot}/rust-service/crates/**/*.rs",
					"${repoRoot}/rust-service/crates/**/Cargo.toml"
				],
				"outputGlobs": [
					"pkg/**",
					"pkg-local/**",
					"../wasm-client/pkg/**"
				],
				"includeLockFiles": false
			}
		},
		"tasks": {
			"build": {
				"dependsOn": [
					"check:format",
					"compile",
					"lint"
				],
				"script": false
			},
			"compile": {
				"dependsOn": [
					"build:typescript",
					"typecheck:shared-tree",
					"build:shared-tree",
					"build:benchmarks"
				],
				"script": false
			},
			"build:typescript": [
				"^build:package:esm",
				"build:wasm"
			],
			"typecheck": [
				"^build:package:esm"
			],
			"typecheck:shared-tree": [
				"^build:package:esm",
				"build:wasm"
			],
			"build:shared-tree": [
				"^build:package:esm",
				"build:wasm"
			],
			"build:benchmarks": [
				"^build:package:esm",
				"build:wasm"
			],
			"test": {
				"dependsOn": [
					"test:node"
				],
				"script": false
			},
			"test:node": [
				"build:typescript",
				"build:wasm"
			]
		}
	}
}
