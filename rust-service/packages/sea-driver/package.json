{
	"name": "@fluidframework/sea-driver",
	"version": "3.2.0",
	"description": "Fluid driver for the Sea Rust service.",
	"homepage": "https://fluidframework.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/microsoft/FluidFramework.git",
		"directory": "rust-service/packages/sea-driver"
	},
	"license": "MIT",
	"author": "Microsoft and contributors",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./lib/public.d.ts",
			"default": "./lib/index.js"
		},
		"./internal": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"scripts": {
		"build": "fluid-build . --task build",
		"build:api-reports": "api-extractor run --local --config api-extractor/api-extractor-report.json",
		"build:compile": "fluid-build . --task compile",
		"build:entrypoints": "fluid-build . --task build:entrypoints",
		"build:entrypoints:esm": "flub generate entrypoints --outDir ./lib",
		"build:esm": "tsc --project ./tsconfig.json",
		"build:genver": "gen-version",
		"build:test:esm": "tsc --project ./src/test/tsconfig.json",
		"check:exports": "concurrently \"npm:check:exports:*\"",
		"check:exports:bundle-release-tags": "api-extractor run --config api-extractor/api-extractor-lint-bundle.json",
		"check:exports:public": "api-extractor run --config api-extractor/api-extractor-lint-public.json",
		"check:format": "biome check .",
		"ci:build:api-reports": "api-extractor run --config api-extractor/api-extractor-report.json",
		"clean": "rimraf --glob lib \"**/*.tsbuildinfo\" \"**/*.build.log\" _api-extractor-temp nyc",
		"format": "biome check . --write",
		"lint": "biome lint src",
		"test": "fluid-build . --task test:node",
		"test:node": "node --test \"lib/test/*.test.js\""
	},
	"dependencies": {
		"@fluid-internal/client-utils": "workspace:~",
		"@fluidframework/container-definitions": "workspace:~",
		"@fluidframework/container-loader": "workspace:~",
		"@fluidframework/container-runtime": "workspace:~",
		"@fluidframework/core-interfaces": "workspace:~",
		"@fluidframework/core-utils": "workspace:~",
		"@fluidframework/driver-definitions": "workspace:~",
		"@fluidframework/runtime-utils": "workspace:~",
		"@fluidframework/sea-typescript": "workspace:~",
		"@fluidframework/telemetry-utils": "workspace:~"
	},
	"devDependencies": {
		"@biomejs/biome": "~2.4.5",
		"@fluid-tools/build-cli": "catalog:buildTools",
		"@fluidframework/build-tools": "catalog:buildTools",
		"@fluidframework/shared-object-base": "workspace:~",
		"@microsoft/api-extractor": "7.58.1",
		"@types/node": "catalog:types",
		"concurrently": "^10.0.3",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3"
	},
	"fluidBuild": {
		"tasks": {
			"test:node": [
				"build:test:esm"
			]
		}
	}
}
