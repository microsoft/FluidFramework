{
	"name": "@fluidframework/sea-typescript",
	"version": "3.2.0",
	"description": "Transport-independent TypeScript sessions for the Sea service.",
	"homepage": "https://fluidframework.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/microsoft/FluidFramework.git",
		"directory": "rust-service/packages/sea-typescript"
	},
	"license": "MIT",
	"author": "Microsoft and contributors",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./lib/public.d.ts",
			"default": "./lib/index.js"
		},
		"./internal": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./internal/memory": {
			"types": "./lib/memory.d.ts",
			"default": "./lib/memory.js"
		},
		"./internal/presets": {
			"types": "./lib/presets.d.ts",
			"default": "./lib/presets.js"
		},
		"./internal/webtransport": {
			"types": "./lib/webtransport.d.ts",
			"default": "./lib/webtransport.js"
		},
		"./internal/websocket": {
			"types": "./lib/websocket.d.ts",
			"default": "./lib/websocket.js"
		}
	},
	"scripts": {
		"build": "fluid-build . --task build",
		"build:api-reports": "api-extractor run --local --config api-extractor/api-extractor-report.json",
		"build:compile": "fluid-build . --task compile",
		"build:entrypoints": "fluid-build . --task build:entrypoints",
		"build:entrypoints:esm": "flub generate entrypoints --outDir ./lib",
		"build:esm": "tsc --project ./tsconfig.json",
		"build:wasm": "node scripts/build-wasm.mjs",
		"check:exports": "concurrently \"npm:check:exports:*\"",
		"check:exports:bundle-release-tags": "api-extractor run --config api-extractor/api-extractor-lint-bundle.json",
		"check:exports:public": "api-extractor run --config api-extractor/api-extractor-lint-public.json",
		"check:format": "biome check .",
		"ci:build:api-reports": "api-extractor run --config api-extractor/api-extractor-report.json",
		"clean": "rimraf --glob lib generated \"**/*.tsbuildinfo\" \"**/*.build.log\" _api-extractor-temp nyc",
		"format": "biome check . --write",
		"lint": "biome lint src",
		"test": "node --test \"test/*.test.mjs\""
	},
	"devDependencies": {
		"@biomejs/biome": "~2.4.5",
		"@fluid-tools/build-cli": "catalog:buildTools",
		"@fluidframework/build-tools": "catalog:buildTools",
		"@microsoft/api-extractor": "7.58.1",
		"concurrently": "^10.0.3",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3"
	},
	"fluidBuild": {
		"tasks": {
			"build:wasm": {
				"files": {
					"inputGlobs": [
						"package.json",
						"scripts/build-wasm.mjs",
						"${repoRoot}/rust-service/Cargo.toml",
						"${repoRoot}/rust-service/Cargo.lock",
						"${repoRoot}/rust-service/rust-toolchain.toml",
						"${repoRoot}/rust-service/crates/**/*.rs",
						"${repoRoot}/rust-service/crates/**/Cargo.toml",
						"!${repoRoot}/rust-service/crates/**/target/**",
						"!${repoRoot}/rust-service/crates/**/pkg/**"
					],
					"outputGlobs": [
						"generated/**"
					],
					"gitignore": [],
					"includeLockFiles": false
				}
			},
			"build:esm": [
				"build:wasm"
			],
			"test": [
				"build:esm"
			]
		}
	}
}
